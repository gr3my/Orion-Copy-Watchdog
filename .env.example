# ─────────────────────────────────────────────────────────────────────────────
# Orion Copy Watchdog environment — only variables actually read by the watchdog.
# Copy to `.env` (Windows: Copy-Item .env.example .env) and fill in values.
# NEVER commit `.env`. Reference these from watchdog.yml as ${VAR_NAME}.
# The config file location itself can be set with ORION_WATCHDOG_CONFIG.
# ─────────────────────────────────────────────────────────────────────────────

# Config file location (optional; default is ./watchdog.yml next to the binary,
# then %ProgramData%\OrionCopyWatchdog\watchdog.yml on Windows,
# /etc/orion-copy-watchdog/watchdog.yml on Linux).
ORION_WATCHDOG_CONFIG=

# Log level override (debug, info, warn, error). Config file value is used when unset.
ORION_WATCHDOG_LOG_LEVEL=

# Optional Orion Copy Server reporting (reporting.enabled must be true in watchdog.yml).
ORION_API_URL=
ORION_WATCHDOG_API_KEY=

# Optional generic webhook for service_down / restart / recovery events
# (notifications.webhook.enabled must be true in watchdog.yml).
ORION_WATCHDOG_WEBHOOK=
